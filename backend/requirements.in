# The backend's direct runtime dependencies, written by hand (ADR-189).
# Never installed from directly: `pip-compile` turns this into
# requirements.txt, with an exact version and hashes for every package,
# transitive ones included. To change a dependency, edit this file and run
#   venv/bin/pip-compile --generate-hashes --strip-extras requirements.in
# then review the diff as ADR-189 point 5 says, in a commit of its own.
fastapi
uvicorn
psycopg2-binary
sqlalchemy
# SQLAlchemy needs greenlet only on some processors (Linux x86-64, CI's) and
# not on Apple Silicon, so a lock compiled on a Mac left it out and CI's
# hash-checked install refused it (2026-10-08). Declared so it is locked, with
# hashes for every platform, wherever the lock is compiled.
greenlet
jinja2
# Imported by our own code (app/rendering/service.py), not only by Jinja.
markupsafe
# Imported by our own code (app/pagination.py and the models), not only by FastAPI.
pydantic
css-inline
# Runtime, not only tests: the Claude adapter and the Resend provider use it.
httpx
python-multipart
