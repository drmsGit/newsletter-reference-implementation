# Local secrets for the dev server. Copy to backend/.env (gitignored) and fill in.
# main.py loads this file into the environment at startup; a real environment
# variable always wins. Credentials never live in code or the database.

# --- Outbound sending (ADR-100) ---------------------------------------------
# Required only to send for real; provider="mock" needs none of this.
RESEND_API_KEY=re_...
# Verified sender. Defaults to Resend's sandbox sender, which only delivers to
# your own account email until your domain's DNS is verified.
RESEND_FROM=News <news@yourdomain.com>
# Shared secret used to verify inbound engagement webhooks.
RESEND_WEBHOOK_SECRET=whsec_...

# --- AI model (ADR-144) ------------------------------------------------------
# Required only when Settings → AI model is set to "claude"; the default "mock"
# adapter needs no key and costs nothing.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model id. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
