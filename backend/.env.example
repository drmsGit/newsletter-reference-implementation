# Copy this file to  backend/.env  and fill in real values.
# backend/.env is gitignored — never commit it, never paste keys into chat.

# --- Resend outbound provider (used when a send instance's provider = "resend")
RESEND_API_KEY=re_your_api_key_here

# Verified sender address. Until your sending domain's SPF/MX finish verifying,
# use Resend's sandbox sender, which delivers ONLY to your own account email:
#   RESEND_FROM=onboarding@resend.dev
RESEND_FROM=Newsletter <news@your-verified-domain.com>
