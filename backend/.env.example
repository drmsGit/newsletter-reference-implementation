# Local secrets for the dev server. Copy to backend/.env (gitignored) and fill in.
# main.py loads this file into the environment at startup; a real environment
# variable always wins. Credentials never live in code or the database.

# --- Outbound sending (ADR-100) ---------------------------------------------
# Required only to send for real; provider="mock" needs none of this.
RESEND_API_KEY=re_...
# Verified sender. Defaults to Resend's sandbox sender, which only delivers to
# your own account email until your domain's DNS is verified.
RESEND_FROM=News <news@yourdomain.com>
# Shared secret used to verify inbound engagement webhooks.
RESEND_WEBHOOK_SECRET=whsec_...

# --- Sign-in (ADR-151) -------------------------------------------------------
# Seeds the first Admin account, but only while the user table is empty.
# Without it nobody can sign in on a fresh install.
INITIAL_ADMIN_EMAIL=you@yourdomain.com
# --- System mail (operator-facing, NOT customer-facing) ----------------------
# A third category alongside marketing and transactional: mail to your own
# operators. Sign-in codes today; approval notifications and AI alerts later.
# Kept separate because the failure mode is circular — if it lands in spam,
# nobody can sign in to fix whatever caused that.
#
# Which provider carries it. Defaults to "mock", which sends nothing and shows
# the code on screen instead. Deliberately NOT inferred from RESEND_API_KEY
# being present: a dev machine legitimately holds a real key for send testing.
SYSTEM_MAIL_PROVIDER=mock
# Sender for system mail. Use a SEPARATE verified domain or subdomain from the
# marketing sender above. Falls back to RESEND_FROM with a warning.
SYSTEM_MAIL_FROM=System <noreply@system.yourdomain.com>
# Force the sign-in code to be shown on screen even with a real provider set.
AUTH_DEV_SHOW_CODE=

# --- AI model (ADR-144) ------------------------------------------------------
# Required only when Settings → AI model is set to "claude"; the default "mock"
# adapter needs no key and costs nothing.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model id. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
