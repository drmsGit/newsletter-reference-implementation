# Development and test tools (ADR-189), compiled against the runtime lock so
# the two cannot disagree on a package they share. A deployment never
# installs these. Compile with
#   venv/bin/pip-compile --generate-hashes --strip-extras --allow-unsafe requirements-dev.in
-c requirements.txt
pytest
# The lock tool itself, so its own version is locked too.
pip-tools
