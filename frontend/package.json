{
  "name": "manager-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The manager client for this reference architecture. Plain React SPA per ADR-170; dependencies per ADR-173. Deliberately not named after the product, whose name is provisional and lives in product.json at the repository root -- see src/branding.ts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:client": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts",
    "check:contract": "npm run generate:client && git diff --exit-code -- src/api/schema.d.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
