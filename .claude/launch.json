{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "newsletter-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && source venv/bin/activate && uvicorn main:app --reload --port 8000"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "newsletter-client",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && npm run dev"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
