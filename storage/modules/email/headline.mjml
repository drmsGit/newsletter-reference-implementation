<mjml>
  <mj-head>
    <mj-include path="./_attributes.mjml" />
  </mj-head>
  <mj-body width="600px">
    <!-- Headline (ADR-198): an H2 typed into the module. -->
    <mj-section padding="24px 0 8px 0">
      <mj-column>
        <mj-text padding="0"><h2 style="margin:0;font-size:26px;line-height:1.2;color:{{ profile.colour_text or '#1a1a1a' }}">{{ heading }}</h2></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
