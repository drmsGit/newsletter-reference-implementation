{
  "label": "Notification",
  "channel": "push",
  "description": "The whole push message. APNs, FCM and Web Push all take structured fields inside roughly 4 KB, and the receiving OS does the rendering — so this module has no template.",
  "cms": true,
  "has_template": false,
  "variables": [
    {
      "name": "push_title",
      "required": true,
      "label": "Notification title"
    },
    {
      "name": "push_body",
      "required": true,
      "label": "Notification text"
    },
    {
      "name": "push_image_url",
      "required": false,
      "label": "Image URL"
    },
    {
      "name": "push_link",
      "required": false,
      "label": "Opens this link"
    }
  ]
}
